# Copy to .env and edit: cp .env.example .env
# REQUIRED. Where devices reach the plain-HTTP port. Baked into every cert issued from now on as its
# CRL/CA-issuer URL (existing certs keep the old one). Comma-separate to list several, e.g. a LAN and a VPN name.
HOMECA_PUBLIC_URL=http://ca.example.lan:8080

# ACME: the name clients use for this service (it gets its own TLS cert) and who may use it (comma-separated
# addresses or networks). Leave both empty to disable ACME.
HOMECA_ACME_HOSTNAME=
HOMECA_ACME_CLIENTS=

# Your reverse proxy's address or network, so sign-in limits and the audit log see real client addresses.
HOMECA_TRUSTED_PROXIES=

# Set to 1 once the UI is served over HTTPS by your reverse proxy
HOMECA_SECURE_COOKIE=0
